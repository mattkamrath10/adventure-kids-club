# Owner login username. Login fails if this is missing.
ADMIN_USERNAME=

# Owner login password. Login fails if this is missing.
ADMIN_PASSWORD=

# Secret used to sign the owner session cookie. Login fails if this is missing.
SESSION_SECRET=

# Kit API key for the Join the club signup. The form shows an error if this is missing.
# In Kit, open Developer settings and create a V4 API key. Never put this in a NEXT_PUBLIC_ variable.
KIT_API_KEY=

# Kit form id for the Join the club signup. The form shows an error if this is missing.
KIT_FORM_ID=
